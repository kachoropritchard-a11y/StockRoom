# Copy to .env (git-ignored). Never commit real values.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_PATH=./data/stockroom.db
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=8
# Optional, dev seed only (random passwords are generated and printed if unset)
# SEED_EXECUTIVE_PASSWORD=
# SEED_INVENTORY_PASSWORD=

# Login lockout / hashing
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
